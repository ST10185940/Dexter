## Ignore Visual Studio temporary files, build results, and
## files generated by extensions.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono
mono_crash.*

# Build artifacts
*.dll
*.exe
*.app
*.appx
*.apk
*.dmg
*.ipa
*.lib
*.so
*.a
*.pdb

# Visual Studio Code
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio
.vs/
.vsconfig

# Dotnet specific
project.lock.json
project.fragment.lock.json
artifacts/
*.nuget.props
*.nuget.targets

# NUGET packages
*.nupkg
*.snupkg
# The packages folder can be ignored because of restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if you have nuget.exe downloaded locally
# nuget.exe

# Azure build
*.azurePubxml
*.pubxml
*.publishsettings

# Others
*.cache
*.dbmdl
*.bak
*.backup
*.swp
*.tmp
*.log
*.diff
*.patch

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# Coverlet (code coverage)
coverage*.json
coverage*.xml
coverage*.info

# DotCover
.idea/.idea.DotSettings.user

# Windows system files
Thumbs.db
ehthumbs.db
